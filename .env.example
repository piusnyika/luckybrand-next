# ---- Database (Postgres 16 in Docker: docker compose -f deploy/docker-compose.yml up -d db) ----
# Password = POSTGRES_PASSWORD in deploy/.env. Port: 5434 on the dev PC (DB_HOST_PORT), 5432 on the server.
# In Docker (.env.docker) this is overridden automatically to point at the db container.
DATABASE_URL="postgresql://luckybrand:CHANGE_ME@localhost:5434/luckybrand"

# ---- Site ----
SITE_URL="http://localhost:3000"            # production: https://luckybrand.co.zw
# Required in production, 32+ random characters (e.g. openssl rand -hex 32). The site won't allow logins without it.
AUTH_SECRET="change-me-to-a-long-random-string"
# UPLOADS_DIR="storage/uploads"             # where uploaded images live (default)

# ---- Paynow ----
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""

# ---- N-Genius card payments (Network International: Visa / Mastercard) ----
# From the N-Genius portal: Settings → Integrations → Service accounts (API key) and Settings → Outlets (outlet reference).
# Sandbox: https://api-gateway.sandbox.ngenius-payments.com   Live: the API URL Network International gives you
NGENIUS_API_KEY=""
NGENIUS_OUTLET_REF=""
NGENIUS_API_URL="https://api-gateway.sandbox.ngenius-payments.com"
# NGENIUS_ACTION="PURCHASE"                 # PURCHASE or SALE = charge immediately, AUTH = authorise only (capture in portal)
# NGENIUS_WEBHOOK_SECRET=""                 # optional; send it as header X-Webhook-Secret from the portal's webhook settings

# ---- Background payment check (Paynow + N-Genius) ----
# Runs every 5 minutes inside the app: asks the gateways for the status of pending orders and cancels
# (releases stock for) checkouts still unpaid after PAYMENT_TIMEOUT_MINUTES. Nothing to set up.
# PAYMENT_TIMEOUT_MINUTES="60"
# PAYMENT_SYNC="off"                         # only if you run it from an external cron instead:
# CRON_SECRET=""                             #   curl "https://your-site/api/cron/payments/?secret=CRON_SECRET"

# ---- Email (order confirmations, password resets, contact form) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Lucky Brand <sales@luckybrand.co.zw>"
ADMIN_EMAIL=""                              # defaults to the store email in Settings

# ---- Optional: "Continue with Google" login ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: <SITE_URL>/api/auth/google/callback/   (e.g. http://localhost:3000/api/auth/google/callback/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Optional: AI assistant in the chat bubble (model and limits: Admin → Settings → Integrations) ----
# From https://console.anthropic.com → API keys. Keep it secret: anyone with it can spend on your account.
ANTHROPIC_API_KEY=""

# ---- Optional: Mailchimp newsletter sync ----
MAILCHIMP_API_KEY=""
MAILCHIMP_LIST_ID=""
