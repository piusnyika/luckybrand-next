// Database schema (Prisma + Postgres). Change it, then run `npm run db:migrate -- --name what_changed`
// and commit the new folder under prisma/migrations. The server applies them with `npm run db:deploy`.
//
// Field names are camelCase in code; @map/@@map keep the snake_case column and table names.
// Status-like columns are plain strings (values listed in comments and in src/lib/db-types.ts):
// Prisma enums can't hold values such as "on-hold".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  username       String?   @db.VarChar(191)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  firstName      String    @default("") @map("first_name") @db.VarChar(120)
  lastName       String    @default("") @map("last_name") @db.VarChar(120)
  displayName    String    @default("") @map("display_name") @db.VarChar(191)
  phone          String    @default("") @db.VarChar(50)
  /// admin | manager | customer
  role           String    @default("customer") @db.VarChar(20)
  /// raised when the password changes, which signs out every existing session
  sessionVersion Int       @default(0) @map("session_version")
  /// blocked accounts can't log in; existing sessions stop working
  blocked        Boolean   @default(false)
  billing        Json?
  shipping       Json?
  resetToken     String?   @map("reset_token") @db.VarChar(100)
  resetExpires   DateTime? @map("reset_expires")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(512)
  alt       String   @default("") @db.VarChar(255)
  title     String   @default("") @db.VarChar(255)
  mime      String   @default("image/jpeg") @db.VarChar(100)
  width     Int?
  height    Int?
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")

  productImages ProductImage[]
  mainOf        Product[]

  @@map("media")
}

model Category {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(191)
  slug           String  @unique @db.VarChar(191)
  description    String?
  image          String? @db.VarChar(512)
  parentId       Int?    @map("parent_id")
  sortOrder      Int     @default(0) @map("sort_order")
  showInMenu     Boolean @default(true) @map("show_in_menu")
  seoTitle       String  @default("") @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description")

  parent          Category?         @relation("tree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("tree")
  products        ProductCategory[]
  primaryProducts Product[]

  @@index([parentId], map: "cat_parent")
  @@map("categories")
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(191)
  slug        String  @unique @db.VarChar(191)
  description String?
  image       String? @db.VarChar(512)

  products ProductBrand[]

  @@map("brands")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  products ProductTag[]

  @@map("tags")
}

model Product {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(191)
  sku               String?   @db.VarChar(100)
  /// published | draft | trash
  status            String    @default("published") @db.VarChar(20)
  /// simple | bundle. A bundle is made of other products (ProductBundleItem); its stock comes from them
  type              String    @default("simple") @db.VarChar(20)
  /// set while status is "trash"; restored to statusBeforeTrash, emptied automatically after 30 days
  trashedAt         DateTime? @map("trashed_at")
  /// published | draft
  statusBeforeTrash String?   @map("status_before_trash") @db.VarChar(20)
  shortDescription  String?   @map("short_description")
  description       String?
  specification     String?
  regularPrice      Decimal   @default(0) @map("regular_price") @db.Decimal(12, 2)
  salePrice         Decimal?  @map("sale_price") @db.Decimal(12, 2)
  saleFrom          DateTime? @map("sale_from")
  saleTo            DateTime? @map("sale_to")
  /// instock | outofstock | onbackorder
  stockStatus       String    @default("instock") @map("stock_status") @db.VarChar(20)
  manageStock       Boolean   @default(false) @map("manage_stock")
  stockQty          Int?      @map("stock_qty")
  lowStockAmount    Int?      @map("low_stock_amount")
  weight            String    @default("") @db.VarChar(50)
  featured          Boolean   @default(false)
  badgeText         String    @default("") @map("badge_text") @db.VarChar(100)
  videoUrl          String    @default("") @map("video_url") @db.VarChar(512)
  /// ProductAttribute[]
  attributes        Json?
  seoTitle          String    @default("") @map("seo_title") @db.VarChar(255)
  seoDescription    String?   @map("seo_description")
  focusKeyword      String    @default("") @map("focus_keyword") @db.VarChar(191)
  primaryCategoryId Int?      @map("primary_category_id")
  imageId           Int?      @map("image_id")
  totalSales        Int       @default(0) @map("total_sales")
  views             Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  primaryCategory Category?           @relation(fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  image           Media?              @relation(fields: [imageId], references: [id], onDelete: SetNull)
  categories      ProductCategory[]
  brands          ProductBrand[]
  tags            ProductTag[]
  images          ProductImage[]
  bundleItems     ProductBundleItem[]
  orderItems      OrderItem[]

  @@index([status, createdAt], map: "prod_status_created")
  @@index([featured], map: "prod_featured")
  @@index([sku], map: "prod_sku")
  @@map("products")
}

model ProductCategory {
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId], map: "pc_cat")
  @@map("product_categories")
}

model ProductBrand {
  productId Int @map("product_id")
  brandId   Int @map("brand_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([productId, brandId])
  @@index([brandId], map: "pb_brand")
  @@map("product_brands")
}

model ProductTag {
  productId Int @map("product_id")
  tagId     Int @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId], map: "pt_tag")
  @@map("product_tags")
}

model ProductImage {
  productId Int @map("product_id")
  mediaId   Int @map("media_id")
  position  Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@map("product_images")
}

/// Items in a bundle product: `qty` of product `productId` per one bundle.
/// productId has no foreign key on purpose: when an item is deleted the row stays and the
/// bundle shows it as a missing item and stops selling, instead of silently getting cheaper.
model ProductBundleItem {
  bundleId  Int @map("bundle_id")
  productId Int @map("product_id")
  qty       Int @default(1)
  position  Int @default(0)

  bundle Product @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@index([productId], map: "pbi_product")
  @@map("product_bundle_items")
}

model Order {
  id                 Int       @id @default(autoincrement())
  number             String    @unique @db.VarChar(50)
  /// pending | processing | on-hold | completed | cancelled | refunded | failed
  status             String    @default("pending") @db.VarChar(20)
  userId             Int?      @map("user_id")
  email              String    @db.VarChar(191)
  phone              String    @default("") @db.VarChar(50)
  currency           String    @default("USD") @db.VarChar(10)
  subtotal           Decimal   @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal   @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal   @default(0) @db.Decimal(12, 2)
  couponCode         String?   @map("coupon_code") @db.VarChar(100)
  paymentMethod      String    @default("") @map("payment_method") @db.VarChar(100)
  paymentMethodTitle String    @default("") @map("payment_method_title") @db.VarChar(191)
  transactionId      String    @default("") @map("transaction_id") @db.VarChar(191)
  paynowPollUrl      String?   @map("paynow_poll_url") @db.VarChar(512)
  paynowReference    String?   @map("paynow_reference") @db.VarChar(191)
  /// Address
  billing            Json
  /// Address | null
  shipping           Json?
  shippingMethod     String    @default("") @map("shipping_method") @db.VarChar(191)
  customerNote       String?   @map("customer_note")
  ipAddress          String    @default("") @map("ip_address") @db.VarChar(64)
  accessKey          String    @unique @map("access_key") @db.VarChar(64)
  paidAt             DateTime? @map("paid_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
  notes OrderNote[]

  @@index([status, createdAt], map: "ord_status_created")
  @@index([email], map: "ord_email")
  @@index([userId], map: "ord_user")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int?    @map("product_id")
  name      String  @db.VarChar(255)
  sku       String  @default("") @db.VarChar(100)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  /// BundleSnapshot | null: what one unit of a bundle contained when it was ordered
  bundle    Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId], map: "oi_order")
  @@map("order_items")
}

model OrderNote {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  content    String
  isCustomer Boolean  @default(false) @map("is_customer")
  author     String   @default("system") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "on_order")
  @@map("order_notes")
}

model Coupon {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(100)
  description  String    @default("") @db.VarChar(255)
  /// percent | fixed_cart | fixed_product
  type         String    @default("percent") @db.VarChar(20)
  amount       Decimal   @db.Decimal(12, 2)
  minSpend     Decimal?  @map("min_spend") @db.Decimal(12, 2)
  maxSpend     Decimal?  @map("max_spend") @db.Decimal(12, 2)
  freeShipping Boolean   @default(false) @map("free_shipping")
  usageLimit   Int?      @map("usage_limit")
  usageCount   Int       @default(0) @map("usage_count")
  expiresAt    DateTime? @map("expires_at")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model ShippingMethod {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  /// free | flat | pickup
  type      String   @db.VarChar(20)
  cost      Decimal  @default(0) @db.Decimal(12, 2)
  minAmount Decimal? @map("min_amount") @db.Decimal(12, 2)
  note      String   @default("") @db.VarChar(255)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")

  @@map("shipping_methods")
}

model Page {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(191)
  content        String
  published      Boolean  @default(true)
  seoTitle       String   @default("") @map("seo_title") @db.VarChar(255)
  seoDescription String?  @map("seo_description")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("pages")
}

model MenuItem {
  id       Int    @id @default(autoincrement())
  menu     String @db.VarChar(50)
  label    String @db.VarChar(191)
  url      String @db.VarChar(512)
  parentId Int?   @map("parent_id")
  position Int    @default(0)

  @@index([menu, position], map: "menu_pos")
  @@map("menu_items")
}

model Setting {
  key   String @id @db.VarChar(100)
  value Json

  @@map("settings")
}

model Redirect {
  id        Int      @id @default(autoincrement())
  from      String   @unique @map("from_path") @db.VarChar(191)
  to        String   @map("to_path") @db.VarChar(512)
  code      Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("redirects")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  email     String   @db.VarChar(191)
  phone     String   @default("") @db.VarChar(50)
  subject   String   @default("") @db.VarChar(255)
  message   String
  read      Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}
